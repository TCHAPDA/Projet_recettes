{% extends 'base.html.twig' %}

{% block title %}Créer un ingrédient v2{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Créer un nouvel ingrédient (v2)</h1>

    {# {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.price) }}

        <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
    {{ form_end(form) }} #}
    {# decomposition des form_row #}
    {{ form_start(form, {attr: {'novalidate': 'novalidate'}}) }}
        {# Champ Name #}
        <div class="mb-3">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_help(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        {# Champ Price #}
        <div class="mb-3">
            {{ form_label(form.price) }}
            {{ form_widget(form.price) }}
            {{ form_help(form.price) }}
            {{ form_errors(form.price) }}
        </div>

        <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_ingredient') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
</div>
{% endblock %}